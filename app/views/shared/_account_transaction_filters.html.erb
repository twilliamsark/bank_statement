<%= form_with url: form_url,
      method: :get,
      local: true,
      data: {
        controller: "live-filter",
        live_filter_delay_value: 250,
        turbo_frame: "transactions"
      },
      class: "card-pad space-y-4" do %>
  <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between">
    <div class="min-w-0">
      <p class="stat-label">Filters</p>
      <p class="mt-1 text-sm text-muted">Date and section apply immediately; description and amount update as you type.</p>
    </div>
    <% if filtered %>
      <%= link_to "Clear filters", clear_url,
            data: { turbo_frame: "transactions" },
            class: "shrink-0 text-sm font-semibold text-brand-700 hover:text-brand-800" %>
    <% end %>
  </div>

  <div class="filter-grid">
    <div>
      <label for="date_from" class="filter-label">From</label>
      <%= date_field_tag :date_from, params[:date_from],
            class: "filter-input",
            data: { action: "change->live-filter#submitNow" } %>
    </div>
    <div>
      <label for="date_to" class="filter-label">To</label>
      <%= date_field_tag :date_to, params[:date_to],
            class: "filter-input",
            data: { action: "change->live-filter#submitNow" } %>
    </div>
    <div>
      <label for="section" class="filter-label">Section</label>
      <%= select_tag :section,
            options_for_select([["All sections", ""]] + sections.map { |s| [s, s] }, params[:section]),
            class: "filter-input",
            data: { action: "change->live-filter#submitNow" } %>
    </div>
    <div class="sm:col-span-2">
      <label for="description" class="filter-label">Description</label>
      <%= text_field_tag :description, params[:description],
            placeholder: "Partial match…",
            autocomplete: "off",
            class: "filter-input",
            data: { action: "input->live-filter#queue" } %>
    </div>
    <div>
      <label for="amount" class="filter-label">Amount</label>
      <%= text_field_tag :amount, params[:amount],
            placeholder: "e.g. 12.3 or -25",
            autocomplete: "off",
            class: "filter-input",
            data: { action: "input->live-filter#queue" } %>
    </div>
  </div>

  <noscript>
    <%= submit_tag "Apply filters", class: "btn-primary cursor-pointer" %>
  </noscript>
<% end %>
