<%#
  locals:
    form: (required)
    record: (required)
    categories: (required) Array of category suggestion strings
    subcategories: (required) Array of subcategory suggestions for current category
    subcategories_by_category: (required) Hash for Stimulus
    require_subcategory: (optional, default false)
%>
<% require_subcategory = local_assigns.fetch(:require_subcategory, false) %>
<% category_present = record.category.present? %>

<div class="relative w-40 shrink-0">
  <label class="sr-only" for="<%= dom_id(record, :category) %>">Category</label>
  <%= form.text_field :category,
        id: dom_id(record, :category),
        autocomplete: "off",
        placeholder: "Category",
        class: "w-full rounded-lg border border-line px-2 py-1.5 text-sm",
        data: {
          category_subcategory_target: "category",
          action: [
            "focus->category-subcategory#categoryFocused",
            "input->category-subcategory#categoryInput",
            "keydown->category-subcategory#categoryKeydown",
            "change->category-subcategory#categoryChanged"
          ].join(" ")
        } %>
  <ul
    data-category-subcategory-target="categoryMenu"
    class="absolute left-0 right-0 z-30 mt-1 hidden max-h-48 overflow-auto rounded-lg border border-line bg-white py-1 text-sm shadow-lg"
    role="listbox"
  ></ul>
</div>

<div class="relative w-40 shrink-0">
  <label class="sr-only" for="<%= dom_id(record, :subcategory) %>">Subcategory</label>
  <%= form.text_field :subcategory,
        id: dom_id(record, :subcategory),
        autocomplete: "off",
        placeholder: (category_present ? "Subcategory" : "Enter category first"),
        disabled: !category_present,
        class: "w-full rounded-lg border border-line px-2 py-1.5 text-sm #{'opacity-50 cursor-not-allowed' unless category_present}",
        data: {
          category_subcategory_target: "subcategory",
          action: [
            "focus->category-subcategory#subcategoryFocused",
            "input->category-subcategory#subcategoryInput",
            "keydown->category-subcategory#subcategoryKeydown",
            "change->category-subcategory#subcategoryChanged"
          ].join(" ")
        } %>
  <ul
    data-category-subcategory-target="subcategoryMenu"
    class="absolute left-0 right-0 z-30 mt-1 hidden max-h-48 overflow-auto rounded-lg border border-line bg-white py-1 text-sm shadow-lg"
    role="listbox"
  ></ul>
</div>
