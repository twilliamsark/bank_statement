<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bank Statement" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bank Statement">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell">
    <header class="sticky top-0 z-40 border-b border-line/80 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <%= link_to root_path, class: "group flex items-center gap-3" do %>
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-700 text-sm font-bold text-white shadow-sm">
            BS
          </span>
          <span>
            <span class="block text-sm font-semibold text-ink group-hover:text-brand-800">Bank Statement</span>
            <span class="block text-xs text-muted">BoA imports &amp; summaries</span>
          </span>
        <% end %>

        <nav class="flex flex-wrap items-center gap-1 text-sm font-medium">
          <%= link_to "Accounts", accounts_path,
                class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-ink #{current_page?(accounts_path) || request.path.start_with?('/accounts') ? 'bg-brand-50 text-brand-800' : ''}" %>
          <%= link_to "Statements", account_statements_path,
                class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-ink #{current_page?(account_statements_path) || request.path.start_with?('/account_statements') ? 'bg-brand-50 text-brand-800' : ''}" %>
          <%= link_to "Credit cards", credit_card_accounts_path,
                class: "rounded-lg px-3 py-2 text-slate-600 hover:bg-slate-100 hover:text-ink #{current_page?(credit_card_accounts_path) || request.path.start_with?('/credit_card_accounts') || request.path.start_with?('/credit_card_statements') ? 'bg-brand-50 text-brand-800' : ''}" %>
        </nav>
      </div>
    </header>

    <main class="app-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
