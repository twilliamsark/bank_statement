<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bank Statement" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Bank Statement">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell flex min-h-screen flex-col">
    <header class="sticky top-0 z-40 border-b border-line/80 bg-white/90 backdrop-blur">
      <div class="app-header-inner">
        <%= link_to root_path, class: "group flex min-w-0 items-center gap-3" do %>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-700 text-sm font-bold text-white shadow-sm">
            BS
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-semibold text-ink group-hover:text-brand-800">Bank Statement</span>
            <span class="hidden text-xs text-muted sm:block">BoA imports &amp; summaries</span>
          </span>
        <% end %>

        <nav class="app-nav" aria-label="Primary">
          <%= nav_link "Accounts", accounts_path, active: nav_section_active?("/accounts") %>
          <%= nav_link "Statements", account_statements_path, active: nav_section_active?("/account_statements") %>
          <%= nav_link "Credit cards", credit_card_accounts_path, active: nav_section_active?("/credit_card_accounts", "/credit_card_statements", "/monthly_credit_card_statements") %>
        </nav>
      </div>
    </header>

    <main class="app-main w-full flex-1">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="app-footer">
      <div class="app-footer-inner">
        <span>Bank Statement</span>
        <span class="hidden sm:inline">Personal BoA import workspace</span>
      </div>
    </footer>
  </body>
</html>
