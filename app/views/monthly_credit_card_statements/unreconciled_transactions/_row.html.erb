<% subcategories = txn.category.present? ? (@subcategories_by_category[txn.category] || []) : [] %>
<% ready = txn.ready_to_save? %>

<tr id="<%= dom_id(txn) %>" class="<%= txn.potential_duplicate? ? "bg-amber-50/70" : (ready ? "bg-brand-50/40" : nil) %>">
  <td class="whitespace-nowrap text-muted"><%= txn.id %></td>
  <td class="whitespace-nowrap"><%= display_date(txn.date) %></td>
  <td class="font-medium text-ink"><%= txn.description %></td>
  <td class="text-right font-medium text-ink"><%= cents_to_currency(txn.amount_cents) %></td>
  <td class="whitespace-nowrap">
    <% if txn.potential_duplicate? %>
      <div class="flex flex-col items-start gap-2">
        <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-900">
          Potential duplicate
        </span>
        <%= button_to "Clear duplicate flag",
              monthly_credit_card_statement_unreconciled_transaction_path(@monthly_credit_card_statement, txn),
              method: :patch,
              params: { unreconciled_transaction: { potential_duplicate: false } }.merge(
                %i[date_from date_to category subcategory description amount page].index_with { |key| params[key] }.compact_blank
              ),
              class: "text-xs font-semibold text-amber-900 underline hover:text-amber-700 cursor-pointer",
              form: {
                data: {
                  turbo: true,
                  turbo_confirm: "Only clear this if you are sure this charge is not already imported."
                }
              } %>
      </div>
    <% else %>
      <span class="text-xs text-muted">—</span>
    <% end %>
  </td>
  <td class="whitespace-nowrap">
    <%= form_with model: txn,
          url: monthly_credit_card_statement_unreconciled_transaction_path(@monthly_credit_card_statement, txn),
          method: :patch,
          class: "flex flex-nowrap items-center gap-2",
          data: {
            controller: "category-subcategory",
            category_subcategory_categories_value: @categories.to_json,
            category_subcategory_options_value: @subcategories_by_category.to_json,
            category_subcategory_require_subcategory_value: true,
            turbo: true
          } do |f| %>
      <% %i[date_from date_to category subcategory description amount page].each do |key| %>
        <%= hidden_field_tag key, params[key] if params[key].present? %>
      <% end %>
      <%= render "shared/category_subcategory_fields",
            form: f,
            record: txn,
            categories: @categories,
            subcategories: subcategories,
            subcategories_by_category: @subcategories_by_category,
            require_subcategory: true %>
    <% end %>

  </td>
</tr>
