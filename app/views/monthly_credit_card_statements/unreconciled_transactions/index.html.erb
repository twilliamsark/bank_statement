<% content_for :title, "Unreconciled transactions" %>

<div class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm text-muted">
        <%= link_to "← #{@monthly_credit_card_statement.credit_card_account.name}",
              credit_card_account_path(@monthly_credit_card_statement.credit_card_account),
              class: "hover:text-brand-700" %>
      </p>
      <h1 class="page-title mt-2">Unreconciled transactions</h1>
      <%= render "monthly_credit_card_statements/unreconciled_transactions/subtitle" %>
    </div>
    <%= render "monthly_credit_card_statements/unreconciled_transactions/actions",
          dom_id: "unreconciled_actions_top",
          show_import: true %>
  </div>

  <% if @categories.empty? %>
    <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
      No categories are available yet. Import a year-end statement first so category and subcategory dropdowns can be populated.
    </div>
  <% end %>

  <%= render "shared/credit_card_transaction_filters",
        form_url: monthly_credit_card_statement_unreconciled_transactions_path(@monthly_credit_card_statement),
        clear_url: monthly_credit_card_statement_unreconciled_transactions_path(@monthly_credit_card_statement),
        categories: @filter_categories,
        subcategories: @filter_subcategories,
        filtered: @filtered,
        turbo_frame: "unreconciled_transactions" %>

  <%= turbo_frame_tag "unreconciled_transactions" do %>
    <%= render "monthly_credit_card_statements/unreconciled_transactions/results" %>
  <% end %>
</div>
