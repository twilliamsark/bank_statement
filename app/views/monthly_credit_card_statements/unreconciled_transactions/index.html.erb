<% content_for :title, "Unreconciled transactions" %>

<div class="space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm text-muted">
        <%= link_to "← #{@monthly_credit_card_statement.credit_card_account.name}",
              credit_card_account_path(@monthly_credit_card_statement.credit_card_account),
              class: "hover:text-brand-700" %>
      </p>
      <h1 class="page-title mt-2">Unreconciled transactions</h1>
      <p class="page-subtitle">
        <%= @monthly_credit_card_statement.credit_card_account.name %>
        <% if @monthly_credit_card_statement.period_start.present? || @monthly_credit_card_statement.period_end.present? %>
          · <%= display_date(@monthly_credit_card_statement.period_start) %> – <%= display_date(@monthly_credit_card_statement.period_end) %>
        <% end %>
        · <%= display_text(@monthly_credit_card_statement.source_filename) %>
        · <%= pluralize(@unreconciled_transactions.size, "transaction") %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @unreconciled_transactions.any? %>
        <%= button_to "Auto Reconcile",
              monthly_credit_card_statement_auto_reconcile_path(@monthly_credit_card_statement),
              method: :post,
              class: "btn-primary cursor-pointer",
              form: { data: { turbo_submits_with: "Reconciling…" } } %>
      <% end %>
      <%= link_to "Import Monthly Statement",
            new_monthly_credit_card_statement_path(credit_card_account_id: @monthly_credit_card_statement.credit_card_account_id),
            class: "btn-secondary" %>
    </div>
  </div>

  <% if @unreconciled_transactions.any? %>
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Description</th>
            <th class="text-right">Amount</th>
            <th>Category</th>
            <th>Subcategory</th>
          </tr>
        </thead>
        <tbody>
          <% @unreconciled_transactions.each do |txn| %>
            <tr>
              <td class="whitespace-nowrap"><%= display_date(txn.date) %></td>
              <td class="font-medium text-ink"><%= txn.description %></td>
              <td class="text-right font-medium text-ink"><%= cents_to_currency(txn.amount_cents) %></td>
              <td><%= display_text(txn.category) %></td>
              <td><%= display_text(txn.subcategory) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex justify-end">
      <%= button_to "Auto Reconcile",
            monthly_credit_card_statement_auto_reconcile_path(@monthly_credit_card_statement),
            method: :post,
            class: "btn-primary cursor-pointer",
            form: { data: { turbo_submits_with: "Reconciling…" } } %>
    </div>
  <% else %>
    <div class="empty-state py-8">No unreconciled transactions on this statement.</div>
  <% end %>
</div>
