<% content_for :title, "Monthly statement transactions" %>

<div class="space-y-6">
  <div>
    <p class="text-sm text-muted">
      <%= link_to "← Statement summary",
            monthly_credit_card_statement_path(@monthly_credit_card_statement),
            class: "hover:text-brand-700" %>
    </p>
    <h1 class="page-title mt-2">Transactions</h1>
    <p class="page-subtitle">
      <%= @monthly_credit_card_statement.credit_card_account.name %>
      · <%= display_text(@monthly_credit_card_statement.source_filename) %>
    </p>
  </div>

  <%= render "shared/credit_card_transaction_filters",
        form_url: monthly_credit_card_statement_transactions_path(@monthly_credit_card_statement),
        clear_url: monthly_credit_card_statement_transactions_path(@monthly_credit_card_statement),
        categories: @categories,
        subcategories: @subcategories,
        filtered: @filtered %>

  <%= turbo_frame_tag "transactions" do %>
    <div class="space-y-4">
      <p class="text-sm text-muted">
        <% if @filtered %>
          <%= pluralize(@filtered_count, "match") %> of <%= pluralize(@total_count, "transaction") %>
        <% else %>
          <%= pluralize(@filtered_count, "transaction") %>
        <% end %>
        <% if @pagination.paginate? %>
          · page <%= @pagination.page %> of <%= @pagination.total_pages %>
        <% end %>
      </p>

      <% if @transactions.any? %>
        <%= render "credit_card_statements/transactions/table", transactions: @transactions, show_statement: false %>
        <%= render "shared/pagination", pagination: @pagination %>
        <%= render "shared/transaction_results_footer",
              filtered: @filtered,
              filtered_count: @filtered_count,
              amount_total_cents: @amount_total_cents %>
      <% else %>
        <div class="empty-state">
          <% if @filtered %>
            No transactions match these filters.
          <% else %>
            No committed transactions on this statement yet.
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
