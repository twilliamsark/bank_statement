<div class="space-y-4">
  <p class="text-sm text-muted">
    <% if filtered %>
      <%= pluralize(filtered_count, "match") %> of <%= pluralize(total_count, "transaction") %>
    <% else %>
      <%= pluralize(filtered_count, "transaction") %>
    <% end %>
    <% if pagination.paginate? %>
      · page <%= pagination.page %> of <%= pagination.total_pages %>
    <% end %>
  </p>

  <% if transactions.any? %>
    <%= render "account_statements/transactions/table", transactions: transactions, show_statement: true %>
    <%= render "shared/pagination", pagination: pagination %>
    <%= render "shared/transaction_results_footer",
          filtered: filtered,
          filtered_count: filtered_count,
          amount_total_cents: amount_total_cents %>
  <% else %>
    <div class="empty-state">
      <% if filtered %>
        No transactions match these filters.
      <% else %>
        No transactions.
      <% end %>
    </div>
  <% end %>
</div>
