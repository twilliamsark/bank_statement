<% content_for :title, @credit_card_account.name %>

<div class="space-y-8">
  <% if @unreconciled_monthly_statement %>
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-brand-200 bg-brand-50 px-4 py-3">
      <p class="text-sm font-medium text-brand-900">
        <%= pluralize(@unreconciled_monthly_statement.unreconciled_transactions.size, "unreconciled transaction") %>
        waiting on a monthly statement.
      </p>
      <%= link_to "View Unreconciled Transactions",
            monthly_credit_card_statement_unreconciled_transactions_path(@unreconciled_monthly_statement),
            class: "btn-primary" %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="text-sm text-muted">
        <%= link_to "← Credit cards", credit_card_accounts_path, class: "hover:text-brand-700" %>
      </p>
      <h1 class="page-title mt-2"><%= @credit_card_account.name %></h1>
      <p class="page-subtitle">
        <%= pluralize(@year_end_statements.size, "year-end statement") %>
        · <%= pluralize(@monthly_statements.size, "monthly statement") %>
        <% if @years_covered %>
          · <%= @years_covered.first == @years_covered.last ? @years_covered.first : "#{@years_covered.first}–#{@years_covered.last}" %>
        <% end %>
        · <%= pluralize(@transaction_count, "transaction") %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "View transactions",
            credit_card_account_transactions_path(@credit_card_account),
            class: "btn-primary" %>
      <%= link_to "Import Year End Statement",
            new_credit_card_statement_path(credit_card_account_id: @credit_card_account.id),
            class: "btn-secondary" %>
      <%= link_to "Import Monthly Statement",
            new_monthly_credit_card_statement_path(credit_card_account_id: @credit_card_account.id),
            class: "btn-secondary" %>
    </div>
  </div>

  <section class="card-pad bg-gradient-to-br from-white to-brand-50">
    <p class="stat-label">Total spend</p>
    <p class="mt-2 text-3xl font-semibold tracking-tight text-ink"><%= cents_to_currency(@total_spend_cents) %></p>
    <p class="mt-2 text-xs text-muted">
      Based on imported transactions for this card across all year-end statements.
    </p>
  </section>

  <section class="grid gap-4 sm:grid-cols-3">
    <div class="card-pad">
      <p class="stat-label">Year-end statements</p>
      <p class="stat-value text-base"><%= @year_end_statements.size %></p>
    </div>
    <div class="card-pad">
      <p class="stat-label">Years covered</p>
      <p class="stat-value text-base">
        <% if @years_covered %>
          <%= @years_covered.first == @years_covered.last ? @years_covered.first : "#{@years_covered.first}–#{@years_covered.last}" %>
        <% else %>
          —
        <% end %>
      </p>
    </div>
    <div class="card-pad">
      <p class="stat-label">Transactions</p>
      <p class="stat-value text-base"><%= @transaction_count %></p>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold text-ink">Category / subcategory totals</h2>
    <% if @category_totals.any? %>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Category</th>
              <th>Subcategory</th>
              <th class="text-right">Total</th>
            </tr>
          </thead>
          <tbody>
            <% @category_totals.sort_by { |(category, subcategory), _| [category, subcategory] }.each do |(category, subcategory), total_cents| %>
              <tr>
                <td class="font-medium text-ink"><%= category %></td>
                <td><%= subcategory %></td>
                <td class="text-right font-medium text-ink"><%= cents_to_currency(total_cents) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state py-8">No transactions on this card.</div>
    <% end %>
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold text-ink">Monthly statements</h2>
    <% if @monthly_statements.any? %>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Period</th>
              <th>File</th>
              <th>Format</th>
              <th>Unreconciled</th>
              <th class="text-right"> </th>
            </tr>
          </thead>
          <tbody>
            <% @monthly_statements.each do |statement| %>
              <tr>
                <td class="font-medium text-ink">
                  <% if statement.period_start.present? || statement.period_end.present? %>
                    <%= display_date(statement.period_start) %> – <%= display_date(statement.period_end) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td><%= display_text(statement.source_filename) %></td>
                <td>
                  <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600">
                    <%= display_text(statement.import_format) %>
                  </span>
                </td>
                <td><%= statement.unreconciled_transactions.size %></td>
                <td class="text-right">
                  <%= link_to "View Unreconciled",
                        monthly_credit_card_statement_unreconciled_transactions_path(statement),
                        class: "font-semibold text-brand-700 hover:text-brand-800" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state py-8">No monthly statements for this card yet.</div>
    <% end %>
  </section>

  <section>
    <h2 class="mb-3 text-lg font-semibold text-ink">Year-end statements</h2>
    <% if @year_end_statements.any? %>
      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Year</th>
              <th>File</th>
              <th>Format</th>
              <th class="text-right">Statement total</th>
              <th>Transactions</th>
              <th class="text-right"> </th>
            </tr>
          </thead>
          <tbody>
            <% @year_end_statements.each do |statement| %>
              <tr>
                <td class="font-medium text-ink"><%= display_text(statement.statement_year) %></td>
                <td><%= display_text(statement.source_filename) %></td>
                <td>
                  <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600">
                    <%= display_text(statement.import_format) %>
                  </span>
                </td>
                <td class="text-right"><%= cents_to_currency(statement.total_spend_cents) %></td>
                <td><%= statement.credit_card_transactions.size %></td>
                <td class="text-right">
                  <%= link_to "View", credit_card_statement_path(statement), class: "font-semibold text-brand-700 hover:text-brand-800" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state py-8">No year-end statements for this card yet.</div>
    <% end %>
  </section>
</div>
