<% subcategories = txn.category.present? ? (@subcategories_by_category[txn.category] || []) : [] %>

<tr id="<%= dom_id(txn) %>">
  <td class="whitespace-nowrap text-muted"><%= txn.id %></td>
  <td class="whitespace-nowrap"><%= display_date(txn.date) %></td>
  <td class="whitespace-nowrap text-sm">
    <% if txn.credit_card_statement %>
      <%= link_to credit_card_statement_path(txn.credit_card_statement), class: "font-medium text-brand-700 hover:text-brand-800" do %>
        <% if txn.credit_card_statement.statement_year.present? %>
          <%= txn.credit_card_statement.statement_year %>
        <% else %>
          <%= display_text(txn.credit_card_statement.source_filename) %>
        <% end %>
      <% end %>
    <% elsif txn.monthly_credit_card_statement %>
      <%= link_to monthly_credit_card_statement_path(txn.monthly_credit_card_statement), class: "font-medium text-brand-700 hover:text-brand-800" do %>
        <%= display_text(txn.monthly_credit_card_statement.source_filename) %>
      <% end %>
    <% else %>
      —
    <% end %>
  </td>
  <td class="min-w-[22rem]">

    <%= form_with model: txn,
          url: credit_card_account_transaction_path(@credit_card_account, txn),
          method: :patch,
          class: "flex flex-wrap items-center gap-2",
          data: {
            controller: "category-subcategory",
            category_subcategory_options_value: @subcategories_by_category.to_json,
            category_subcategory_require_subcategory_value: true,
            turbo: true
          } do |f| %>
      <% %i[date_from date_to category subcategory description amount page].each do |key| %>
        <%= hidden_field_tag key, params[key] if params[key].present? %>
      <% end %>
      <div class="min-w-[10rem] flex-1">
        <label class="sr-only" for="<%= dom_id(txn, :category) %>">Category</label>
        <%= f.select :category,
              options_for_select(@edit_categories, txn.category),
              {},
              id: dom_id(txn, :category),
              class: "w-full rounded-lg border border-line px-2 py-1.5 text-sm",
              data: {
                category_subcategory_target: "category",
                action: "change->category-subcategory#categoryChanged"
              } %>
      </div>
      <div class="min-w-[10rem] flex-1">
        <label class="sr-only" for="<%= dom_id(txn, :subcategory) %>">Subcategory</label>
        <%= f.select :subcategory,
              options_for_select(subcategories, txn.subcategory),
              { include_blank: "—" },
              id: dom_id(txn, :subcategory),
              class: "w-full rounded-lg border border-line px-2 py-1.5 text-sm",
              data: {
                category_subcategory_target: "subcategory",
                action: "change->category-subcategory#subcategoryChanged"
              } %>
      </div>
    <% end %>
  </td>
  <td class="max-w-md"><%= txn.description %></td>
  <td><%= txn.location %></td>
  <td class="whitespace-nowrap text-right font-medium text-ink"><%= cents_to_currency(txn.amount_cents) %></td>
</tr>
