<div class="space-y-4">
  <p class="text-sm text-muted">
    <% if filtered %>
      <%= pluralize(filtered_count, "match") %> of <%= pluralize(total_count, "transaction") %>
    <% else %>
      <%= pluralize(filtered_count, "transaction") %>
    <% end %>
    <% if pagination.paginate? %>
      · page <%= pagination.page %> of <%= pagination.total_pages %>
    <% end %>
  </p>

  <% if transactions.any? %>
    <div class="data-table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Id</th>
            <th>Date</th>
            <th>Statement</th>
            <th>Category / Subcategory</th>
            <th>Description</th>
            <th>Location</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.each do |txn| %>
            <%= render "credit_card_accounts/transactions/row", txn: txn %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/pagination", pagination: pagination %>
    <%= render "shared/transaction_results_footer",
          filtered: filtered,
          filtered_count: filtered_count,
          amount_total_cents: amount_total_cents %>
  <% else %>
    <div class="empty-state">
      <% if filtered %>
        No transactions match these filters.
      <% else %>
        No transactions.
      <% end %>
    </div>
  <% end %>
</div>
