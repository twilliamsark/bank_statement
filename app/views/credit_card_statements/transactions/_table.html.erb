<div class="data-table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Id</th>
        <th>Date</th>
        <% if local_assigns.fetch(:show_statement, false) %>
          <th>Statement</th>
        <% end %>
        <th>Category</th>
        <th>Subcategory</th>
        <th>Description</th>
        <th>Location</th>
        <th class="text-right">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% transactions.each do |txn| %>
        <tr>
          <td><%= txn.id %></td>
          <td class="whitespace-nowrap"><%= display_date(txn.date) %></td>
          <% if local_assigns.fetch(:show_statement, false) %>
            <td class="whitespace-nowrap text-sm">
              <% if txn.credit_card_statement %>
                <%= link_to(
                  credit_card_statement_path(txn.credit_card_statement),
                  class: "font-medium text-brand-700 hover:text-brand-800"
                ) do %>
                  <% if txn.credit_card_statement.statement_year.present? %>
                    <%= txn.credit_card_statement.statement_year %>
                  <% else %>
                    <%= display_text(txn.credit_card_statement.source_filename) %>
                  <% end %>
                <% end %>
              <% elsif txn.monthly_credit_card_statement %>
                <%= link_to(
                  monthly_credit_card_statement_path(txn.monthly_credit_card_statement),
                  class: "font-medium text-brand-700 hover:text-brand-800"
                ) do %>
                  <%= display_text(txn.monthly_credit_card_statement.source_filename) %>
                <% end %>
              <% else %>
                —
              <% end %>
            </td>
          <% end %>
          <td><%= txn.category %></td>
          <td><%= txn.subcategory %></td>
          <td class="max-w-md"><%= txn.description %></td>
          <td><%= txn.location %></td>
          <td class="whitespace-nowrap text-right font-medium text-ink"><%= cents_to_currency(txn.amount_cents) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
