<div class="data-table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <% if local_assigns.fetch(:show_statement, false) %>
          <th>Statement</th>
        <% end %>
        <th>Section</th>
        <th>Description</th>
        <th class="text-right">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% transactions.each do |txn| %>
        <tr>
          <td class="whitespace-nowrap"><%= display_date(txn.date) %></td>
          <% if local_assigns.fetch(:show_statement, false) %>
            <td class="whitespace-nowrap text-sm">
              <%= link_to account_statement_path(txn.account_statement), class: "font-medium text-brand-700 hover:text-brand-800" do %>
                <% if txn.account_statement.period_start || txn.account_statement.period_end %>
                  <%= display_date(txn.account_statement.period_start) %> – <%= display_date(txn.account_statement.period_end) %>
                <% else %>
                  <%= display_text(txn.account_statement.source_filename) %>
                <% end %>
              <% end %>
            </td>
          <% end %>
          <td><%= txn.section %></td>
          <td class="max-w-xl"><%= txn.description %></td>
          <td class="whitespace-nowrap text-right font-medium text-ink"><%= cents_to_currency(txn.amount_cents) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
