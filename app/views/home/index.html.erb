<% content_for :title, "Bank Statement" %>

<div class="space-y-10">
  <section
    class="relative overflow-hidden rounded-3xl border border-line bg-gradient-to-br from-white via-brand-50 to-slate-100 p-8 shadow-sm sm:p-10"
  >
    <div
      class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-brand-100/80 blur-2xl"
    ></div>
    <div class="relative max-w-2xl">
      <p class="eyebrow">Personal finance workspace</p>
      <h1 class="mt-3 page-title">Import Bank of America statements with clear summaries</h1>
      <p class="page-subtitle mt-3 max-w-xl text-base leading-relaxed">
        Upload account or credit-card PDFs and CSVs, review balances and category spend, then browse every transaction in one place.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to(
          "Import account statement",
          new_account_statement_path,
          class: "btn-primary"
        ) %>
        <%= link_to "Browse accounts", accounts_path, class: "btn-secondary" %>
      </div>
    </div>
  </section>

  <section class="grid gap-4 md:grid-cols-3">
    <%= link_to(
      accounts_path,
      class: "card-pad group transition hover:-translate-y-0.5 hover:border-brand-600/30 hover:shadow-md"
    ) do %>
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="eyebrow">Across statements</p>
          <h2 class="mt-2 text-xl font-semibold text-ink">Accounts</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            All transactions for a checking or savings account, combined and filterable.
          </p>
        </div>
        <span
          class="rounded-xl bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-800 group-hover:bg-brand-100"
        >Open</span>
      </div>
    <% end %>

    <%= link_to(
      account_statements_path,
      class: "card-pad group transition hover:-translate-y-0.5 hover:border-brand-600/30 hover:shadow-md"
    ) do %>
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="eyebrow">Checking &amp; savings</p>
          <h2 class="mt-2 text-xl font-semibold text-ink">Statements</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Period balances, section totals, and per-statement transaction lists.
          </p>
        </div>
        <span
          class="rounded-xl bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-800 group-hover:bg-brand-100"
        >Open</span>
      </div>
    <% end %>

    <%= link_to(
      credit_card_accounts_path,
      class: "card-pad group transition hover:-translate-y-0.5 hover:border-brand-600/30 hover:shadow-md"
    ) do %>
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="eyebrow">Credit Card</p>
          <h2 class="mt-2 text-xl font-semibold leading-tight text-ink">
            Statements
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Name your cards, import year-end PDFs, and review category spend by card.
          </p>
        </div>
        <span
          class="rounded-xl bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-800 group-hover:bg-brand-100"
        >Open</span>
      </div>
    <% end %>
  </section>
</div>
